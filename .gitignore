# Ignore all CSV files
*.csv

# Ignore entire data directory contents
data/raw/*
data/processed/*

# Keep folder structure intact using .gitkeep if needed
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained bundles are fetched at runtime (see DEPLOYMENT.md); never commit them
*.joblib

# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
.streamlit/secrets.toml
